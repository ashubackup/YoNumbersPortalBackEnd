
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd">

    <cache alias="games">
        <expiry>
            <ttl unit="seconds">28800</ttl> <!-- Set TTL to 8 hours, cache store time -->
        </expiry>
        <resources>
            <heap unit="entries">100</heap> <!-- Set max entries -->
            <offheap unit="MB">10</offheap> <!-- Off-heap memory size -->
        </resources>
    </cache>
</config>
